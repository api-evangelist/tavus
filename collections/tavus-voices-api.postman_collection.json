          "name": "List Voices",
          "request": {
            "name": "List Voices",
            "description": {
              "content": "Returns available stock **`voice_name`** values and their linked **replica** metadata. When you [Create Replica](/api-reference/phoenix-replica-model/create-replica) with **`train_image_url`** (image-to-replica), **`voice_name`** is required—use this list to pick a valid slug and to preview options.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "voices"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Page size (1–100)."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number (1-based)."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Case-insensitive substring match on `voice_name`."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "asc",
                  "description": "Sort `voice_name` ascending or descending."
                },
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "If set, only voices whose replica tags include this tag name (case-insensitive)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
